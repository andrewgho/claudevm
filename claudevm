#!/usr/bin/env bash
# claudevm - manage isolated Debian development VMs via Lima
# Usage: claudevm <command> [name]

set -euo pipefail

DEFAULT_SKELETON="$HOME/.claudevm/skeleton"
CLAUDE_SESSION="claude"

# ── helpers ─────────────────────────────────────────────────────────────────

die() { echo "claudevm: error: $*" >&2; exit 1; }

require_name() {
    [ -n "${1:-}" ] || die "VM name required"
    echo "$1"
}

require_running() {
    local name="$1"
    local status
    status=$(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null \
        | awk -v n="$name" '$1==n {print $2}')
    [ "$status" = "Running" ] || die "VM '$name' is not running (status: ${status:-not found})"
}

# Return the SSH config file path for a Lima VM
lima_ssh_config() {
    local name="$1"
    local cfg="$HOME/.lima/$name/ssh.config"
    [ -f "$cfg" ] || die "VM '$name' not found (no SSH config at $cfg)"
    echo "$cfg"
}

# Return SSH options for connecting to a VM as the Lima user ($USER).
# Uses Lima's SSH config for key/port; disables ControlMaster (Lima's socket
# is tied to a specific path and may not be accessible here).
vm_ssh_opts() {
    local name="$1"
    local cfg port key
    cfg=$(lima_ssh_config "$name")
    port=$(awk '/^  Port / {print $2}' "$cfg")
    key=$(awk '/^  IdentityFile / {gsub(/"/, "", $2); print $2}' "$cfg")
    echo "-p ${port} -i ${key} -o StrictHostKeyChecking=no -o UserKnownHostsFile=\
/dev/null -o LogLevel=ERROR -o ControlMaster=no -o User=${USER}"
}

# SCP into/from a VM as the Lima user
vm_scp() {
    local name="$1"
    shift
    local cfg port key
    cfg=$(lima_ssh_config "$name")
    port=$(awk '/^  Port / {print $2}' "$cfg")
    key=$(awk '/^  IdentityFile / {gsub(/"/, "", $2); print $2}' "$cfg")
    scp -P "$port" -i "$key" \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        -o ControlMaster=no \
        "$@"
}

# SSH into a VM as the Lima user
vm_ssh() {
    local name="$1"
    shift
    local opts
    opts=$(vm_ssh_opts "$name")
    # shellcheck disable=SC2086
    ssh $opts 127.0.0.1 "$@"
}

# Set the terminal window title (xterm/iTerm2/most modern terminals)
set_title() {
    printf '\033]0;%s\007' "$1" >/dev/tty 2>/dev/null || true
}

# Push the current window title onto the terminal's title stack (xterm CSI 22t).
# iTerm2 and most xterm-compatible terminals support this.
push_title() {
    printf '\033[22;0t' >/dev/tty 2>/dev/null || true
}

# Pop the most recently pushed title off the terminal's title stack (xterm CSI 23t).
pop_title() {
    printf '\033[23;0t' >/dev/tty 2>/dev/null || true
}

# Return the Lima user's home directory on the VM
vm_home() {
    local name="$1"
    vm_ssh "$name" 'echo $HOME'
}

# Wait for cloud-init to finish (called after limactl start)
wait_provision() {
    local name="$1"
    echo "==> Waiting for provisioning to complete..."
    # limactl start already waits for Lima guest agent, but provision scripts
    # run after. Poll until the sentinel file exists.
    local deadline=$((SECONDS + 600))
    while [ $SECONDS -lt $deadline ]; do
        if limactl shell "$name" -- \
            bash -c 'test -f /var/lib/cloud/instance/boot-finished' 2>/dev/null; then
            echo "==> Provisioning complete."
            return 0
        fi
        printf '.'
        sleep 5
    done
    echo ""
    die "Provisioning timed out after 10 minutes"
}

# Populate the Lima user's home directory from a skeleton directory.
# Usage: populate_home <vm-name> [skeleton-path]
# Defaults to ~/.claudevm/skeleton/; silently skips if path does not exist.
populate_home() {
    local name="$1"
    local skeleton="${2:-$DEFAULT_SKELETON}"
    local home
    home=$(vm_home "$name")

    # Create standard directories regardless of skeleton
    vm_ssh "$name" 'mkdir -p ~/work ~/bin ~/go'

    if [ ! -d "$skeleton" ]; then
        [ "$skeleton" = "$DEFAULT_SKELETON" ] \
            || echo "    Warning: skeleton path '$skeleton' not found — skipping."
        return 0
    fi

    local contents
    contents=$(ls -A "$skeleton" 2>/dev/null)
    if [ -z "$contents" ]; then
        return 0
    fi

    echo "==> Copying skeleton from $skeleton..."
    # COPYFILE_DISABLE suppresses macOS extended-attribute entries (com.apple.provenance
    # etc.) that produce warnings from GNU tar in the VM.
    COPYFILE_DISABLE=1 tar --no-xattrs \
        --exclude='.DS_Store' --exclude='.localized' \
        -C "$skeleton" -czf - . \
        | vm_ssh "$name" "tar -xzf - -C '$home'"
    echo "==> Skeleton copied."
}

# Forward Claude Code credentials from the host macOS Keychain into the VM.
# On macOS, Claude Code stores OAuth tokens in the Keychain under
# "Claude Code-credentials". On Linux, it reads from ~/.claude/.credentials.json.
#
# Also copies ~/.claude/settings.json so Claude Code skips the new-user setup
# flow (terminal color preference, etc.) on first launch.
#
# Token expiry note: the access token may have expired; Claude Code should use
# the refresh token automatically. If it still prompts for login, run
# 'claudevm creds <name>' after re-authenticating on the Mac.
sync_credentials() {
    local name="$1"
    local creds
    creds=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) || {
        echo "    (no Claude Code credentials found in Keychain — run 'claude login' on the Mac first)"
        return 0
    }
    echo "==> Forwarding Claude Code credentials to VM '$name'..."

    # Write credentials file
    printf '%s\n' "$creds" \
        | vm_ssh "$name" \
            "mkdir -p ~/.claude && cat > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json"

    # Write VM-specific settings.json.
    # defaultMode=bypassPermissions sets bypass mode via config (avoids the
    # interactive "take responsibility" prompt that the CLI flag triggers).
    # permissions.allow pre-approves all tools so Claude never prompts for
    # individual tool uses — appropriate since this is an isolated sandbox VM.
    vm_ssh "$name" "cat > ~/.claude/settings.json && chmod 644 ~/.claude/settings.json" << 'SETTINGS'
{
  "defaultMode": "bypassPermissions",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "MultiEdit(*)",
      "NotebookEdit(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Skill(*)",
      "Agent(*)"
    ]
  }
}
SETTINGS

    # Copy ~/.claude.json (global state: theme, numStartups, tips history, etc.)
    # This is what Claude Code checks on startup to determine if initialization
    # has been completed. Without it, the color-picker wizard always appears.
    # We also inject a pre-accepted project entry for ~/work so that Claude Code
    # skips the workspace trust dialog and the bypass-permissions acknowledgment.
    local global_state="$HOME/.claude.json"
    if [ -f "$global_state" ]; then
        local vm_work
        vm_work="$(vm_home "$name")/work"
        python3 -c "
import json, sys
with open('$global_state') as f:
    d = json.load(f)
d['remoteControlAtStartup'] = True
d.setdefault('projects', {})['${vm_work}'] = {
    'allowedTools': [],
    'mcpContextUris': [],
    'mcpServers': {},
    'enabledMcpjsonServers': [],
    'disabledMcpjsonServers': [],
    'hasTrustDialogAccepted': True,
    'hasCompletedProjectOnboarding': True,
    'projectOnboardingSeenCount': 1,
    'hasClaudeMdExternalIncludesApproved': False,
    'hasClaudeMdExternalIncludesWarningShown': False,
}
print(json.dumps(d))
" | vm_ssh "$name" "cat > ~/.claude.json && chmod 600 ~/.claude.json"
    fi

    echo "==> Credentials forwarded."
}

# Run Claude Code once in headless -p mode to complete first-run initialization
# (token refresh, plugin marketplace sync, sessions dir creation) without showing
# the interactive setup wizard.
silent_init() {
    local name="$1"
    echo "==> Running Claude Code first-run initialization (headless)..."
    # -p/--print mode skips the interactive wizard entirely; --dangerously-skip-permissions
    # avoids any permission prompts; output is suppressed.
    # Use a login shell so .bash_profile/.bashrc are sourced and claude is on PATH.
    if vm_ssh "$name" \
        "bash -l -c 'cd ~/work && claude -p hello'"; then
        echo "==> Claude Code initialized."
    else
        echo "    Warning: headless initialization returned an error (exit $?)."
        echo "    The setup wizard may appear on first interactive launch."
        echo "    If prompted to log in, re-run: claudevm creds $name"
    fi
}

# Write the embedded Lima template to a temp file and print its path.
# Caller is responsible for deleting the file when done.
write_template() {
    local tmp
    tmp=$(mktemp /tmp/claudevm-XXXXXX.yaml)
    cat > "$tmp" << 'TEMPLATE_EOF'
minimumLimaVersion: 2.0.0

vmType: vz
networks:
- vzNAT: true

images:
- location: "https://cloud.debian.org/images/cloud/trixie/20251117-2299/debian-13-genericcloud-arm64-20251117-2299.qcow2"
  arch: "aarch64"
  digest: "sha512:5075d49a9a85f29d1ee78302785b0d5270fd22c16ca75b4b280f7f4c240fcd34fdfa22ab15a5457aa14fbdbf36d8c5562d1133709b58fc8efdec40e363eba085"
- location: "https://cloud.debian.org/images/cloud/trixie/20251117-2299/debian-13-genericcloud-amd64-20251117-2299.qcow2"
  arch: "x86_64"
  digest: "sha512:e5563c7bb388eebf7df385e99ee36c83cd16ba8fad4bd07f4c3fd725a6f1cf1cb9f54c6673d4274a856974327a5007a69ff24d44f9b21f7f920e1938a19edf7e"
- location: "https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-arm64-daily.qcow2"
  arch: "aarch64"
- location: "https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
  arch: "x86_64"

cpus: 4
memory: "6GiB"
disk: "40GiB"

mounts: []

portForwards:
- guestPort: 3000
  hostPort: 3000
- guestPort: 4000
  hostPort: 4000
- guestPort: 5000
  hostPort: 5000
- guestPort: 8000
  hostPort: 8000
- guestPort: 8080
  hostPort: 8080
- guestPort: 8888
  hostPort: 8888
- guestPort: 9000
  hostPort: 9000

provision:
- mode: system
  script: |
    #!/bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    echo "==> Updating package lists"
    apt-get update -q

    echo "==> Installing base packages"
    apt-get install -y -q \
      build-essential \
      git \
      emacs-nox \
      vim \
      curl \
      wget \
      tmux \
      screen \
      python3 \
      python3-pip \
      python3-venv \
      python3-dev \
      golang \
      ca-certificates \
      gnupg \
      sudo \
      less \
      man-db \
      unzip \
      zip \
      jq \
      htop \
      procps \
      lsof \
      netcat-openbsd \
      dnsutils \
      rsync \
      file \
      tree \
      make \
      cmake \
      gcc \
      g++ \
      pkg-config \
      libssl-dev \
      libffi-dev

    echo "==> Fixing vsock SSH hostname resolution"
    echo '127.0.0.1 UNKNOWN' >> /etc/hosts

    echo "==> Configuring sudoers"
    cat > /etc/sudoers.d/claudevm << 'SUDOERS'
    Defaults !lecture
    Defaults !requiretty
    Defaults timestamp_timeout=300
    %sudo ALL=(ALL) NOPASSWD: ALL
    SUDOERS
    chmod 440 /etc/sudoers.d/claudevm

    echo "==> Provision complete"

- mode: user
  script: |
    #!/bin/bash
    set -euo pipefail

    echo "==> Installing NVM + Node.js 22 + Claude Code"
    export NVM_DIR="$HOME/.nvm"
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
    # shellcheck disable=SC1091
    source "$NVM_DIR/nvm.sh"
    nvm install 22
    nvm alias default 22
    npm install -g @anthropic-ai/claude-code

    echo "==> Setup complete"
TEMPLATE_EOF
    echo "$tmp"
}

# ── commands ────────────────────────────────────────────────────────────────

cmd_create() {
    local name skeleton=""
    # Parse --skeleton <path> before the positional name argument
    while [ $# -gt 0 ]; do
        case "$1" in
            --skeleton)
                shift
                skeleton="${1:-}"
                [ -n "$skeleton" ] || die "--skeleton requires a path argument"
                shift
                ;;
            --skeleton=*)
                skeleton="${1#--skeleton=}"
                shift
                ;;
            *)
                break
                ;;
        esac
    done
    name=$(require_name "${1:-}")

    # Check if already exists
    if limactl list --format '{{.Name}}' 2>/dev/null | grep -qx "$name"; then
        die "VM '$name' already exists. Use 'claudevm destroy $name' first, or 'claudevm claude $name' to connect."
    fi

    echo "==> Creating VM '$name' (this will take several minutes on first run)"
    echo ""

    local tmpfile
    tmpfile=$(write_template)
    limactl create --tty=false --name="$name" "$tmpfile"
    rm -f "$tmpfile"
    limactl start "$name"

    wait_provision "$name"
    populate_home "$name" ${skeleton:+"$skeleton"}
    sync_credentials "$name"
    silent_init "$name"

    echo ""
    echo "==> VM '$name' is ready."
    echo "    Connecting to Claude Code session..."
    echo ""

    cmd_claude "$name"
}

cmd_claude() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"

    push_title
    set_title "ClaudeVM: $name"
    echo "==> Attaching to Claude Code session in VM '$name'..."
    echo "    (tmux session '$CLAUDE_SESSION' — detach with Ctrl-q d)"
    echo ""

    # Attach to existing tmux session or create new one running Claude Code.
    # If the session exists but Claude Code has exited (leaving a bare shell),
    # send it the command to restart Claude rather than just attaching.
    vm_ssh "$name" -t "bash -l -c '
        if tmux has-session -t \"$CLAUDE_SESSION\" 2>/dev/null; then
            # Session exists — check if claude is still running in it
            if ! tmux list-panes -t \"$CLAUDE_SESSION\" -F \"#{pane_current_command}\" \
                | grep -qE \"^claude\$\"; then
                # Claude exited; restart it in the existing session window
                tmux send-keys -t \"$CLAUDE_SESSION\" \
                    \"cd ~/work && claude\" Enter
            fi
            tmux attach-session -t \"$CLAUDE_SESSION\"
        else
            tmux new-session -s \"$CLAUDE_SESSION\" -c ~/work -- claude
        fi
    '" || true
    pop_title
}

cmd_ssh() {
    local name
    name=$(require_name "${1:-}")
    shift
    require_running "$name"

    # Split remaining args into SSH flags and optional remote command.
    # Args starting with '-' before the first non-flag arg (or '--') are passed
    # to SSH as options. Everything after '--' or the first non-'-' arg is the
    # remote command (e.g. 'claudevm ssh myvm -A foo' or 'claudevm ssh myvm -- foo').
    local -a ssh_flags=() remote_cmd=()
    local sep=false
    for arg in "$@"; do
        if $sep; then
            remote_cmd+=("$arg")
        elif [ "$arg" = "--" ]; then
            sep=true
        elif [ "${arg#-}" = "$arg" ]; then
            # First non-flag arg: it and the rest form the remote command
            remote_cmd+=("$arg")
            sep=true
        else
            ssh_flags+=("$arg")
        fi
    done

    local opts
    opts=$(vm_ssh_opts "$name")
    push_title
    set_title "ClaudeVM: $name"
    if [ ${#remote_cmd[@]} -eq 0 ]; then
        echo "==> Connecting to VM '$name'..."
        # shellcheck disable=SC2086
        ssh $opts -t "${ssh_flags[@]+"${ssh_flags[@]}"}" 127.0.0.1 "bash -l" || true
    else
        # shellcheck disable=SC2086
        ssh $opts "${ssh_flags[@]+"${ssh_flags[@]}"}" 127.0.0.1 "${remote_cmd[@]}" || true
    fi
    pop_title
}

cmd_root() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"

    echo "==> Connecting as root in VM '$name'..."
    limactl shell "$name" -- sudo -i bash
}

cmd_creds() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"
    sync_credentials "$name"
}

cmd_suspend() {
    local name
    name=$(require_name "${1:-}")
    echo "==> Suspending VM '$name'..."
    limactl stop "$name"
    echo "==> VM '$name' suspended. Resume with: claudevm resume $name"
}

cmd_resume() {
    local name
    name=$(require_name "${1:-}")
    echo "==> Resuming VM '$name'..."
    limactl start "$name"
    echo "==> VM '$name' is running."
}

cmd_destroy() {
    local name
    name=$(require_name "${1:-}")

    echo "WARNING: This will permanently delete VM '$name' and all its data."
    printf "Type the VM name to confirm: "
    read -r confirm
    [ "$confirm" = "$name" ] || die "Aborted."

    limactl stop "$name" 2>/dev/null || true
    limactl delete "$name"
    echo "==> VM '$name' deleted."
}

cmd_list() {
    limactl list
}

cmd_ip() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"

    local cfg port vm_ip
    cfg=$(lima_ssh_config "$name")
    port=$(awk '/^  Port / {print $2}' "$cfg")
    vm_ip=$(limactl shell "$name" -- hostname -I 2>/dev/null | awk '{print $1}')

    echo "VM internal IP : $vm_ip (not directly reachable from host)"
    echo "SSH             : 127.0.0.1:$port"
    echo "Services        : 127.0.0.1:<port> (see portForwards in template.yaml)"
    echo ""
    echo "For direct IP access, install socket_vmnet:"
    echo "  brew install socket_vmnet"
    echo "  sudo brew services start socket_vmnet"
    echo "  (then add 'networks: [{lima: shared}]' to template.yaml)"
}

cmd_ssh_config() {
    local name
    name=$(require_name "${1:-}")
    local cfg port key
    cfg=$(lima_ssh_config "$name")
    port=$(awk '/^  Port / {print $2}' "$cfg")
    key=$(awk '/^  IdentityFile / {gsub(/"/, "", $2); print $2}' "$cfg")

    cat <<EOF
Host claudevm-$name
    HostName 127.0.0.1
    Port $port
    User $USER
    IdentityFile $key
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
EOF
}

cmd_status() {
    local name="${1:-}"
    if [ -n "$name" ]; then
        limactl list --format '{{.Name}} {{.Status}} {{.CPUs}} {{.Memory}} {{.Disk}}' \
            | awk -v n="$name" 'NR==1 || $1==n'
    else
        cmd_list
    fi
}

cmd_push() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"

    if [ $# -eq 1 ]; then
        # Auto mode: mirror CWD to the same path relative to HOME in the VM
        local rel remote_path home
        rel="${PWD#"$HOME"/}"
        [ "$rel" != "$PWD" ] || die "Current directory ($PWD) is not under \$HOME ($HOME)"
        home=$(vm_home "$name")
        remote_path="$home/$rel"
        echo "==> Pushing $PWD -> VM:$remote_path"
        COPYFILE_DISABLE=1 tar --no-xattrs -C "$PWD" -czf - . \
            | vm_ssh "$name" "mkdir -p '$remote_path' && tar -xzf - -C '$remote_path'"
    else
        local src dst
        src="${2:-}"
        [ -n "$src" ] || die "Usage: claudevm push <name> [<local-path> [<remote-path>]]"
        dst="${3:-~/work/$(basename "$src")}"
        vm_scp "$name" -r "$src" "$USER@127.0.0.1:$dst"
    fi
}

cmd_pull() {
    local name
    name=$(require_name "${1:-}")
    require_running "$name"

    if [ $# -eq 1 ]; then
        # Auto mode: mirror the same path relative to HOME in the VM to CWD
        local rel remote_path home
        rel="${PWD#"$HOME"/}"
        [ "$rel" != "$PWD" ] || die "Current directory ($PWD) is not under \$HOME ($HOME)"
        home=$(vm_home "$name")
        remote_path="$home/$rel"
        echo "==> Pulling VM:$remote_path -> $PWD"
        vm_ssh "$name" "tar -C '$remote_path' -czf - ." | tar -xzf - -C "$PWD"
    else
        local src dst
        src="${2:-}"
        [ -n "$src" ] || die "Usage: claudevm pull <name> [<remote-path> [<local-path>]]"
        dst="${3:-.}"
        vm_scp "$name" -r "$USER@127.0.0.1:$src" "$dst"
    fi
}

cmd_port_forward() {
    # Ad-hoc port forwarding: claudevm forward <name> <guest-port> [host-port]
    local name="${1:-}"
    local guest_port="${2:-}"
    local host_port="${3:-$guest_port}"
    name=$(require_name "$name")
    [ -n "$guest_port" ] || die "Usage: claudevm forward <name> <guest-port> [host-port]"
    require_running "$name"

    local opts
    opts=$(vm_ssh_opts "$name")
    echo "==> Forwarding host:$host_port -> VM:$guest_port (Ctrl-C to stop)"
    # shellcheck disable=SC2086
    ssh $opts -N -L "${host_port}:127.0.0.1:${guest_port}" 127.0.0.1
}

# ── dispatch ─────────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
claudevm - manage isolated Debian development VMs

Usage:
  claudevm create [--skeleton <dir>] <name>
                                 Create VM, provision, drop into Claude Code
                                 Skeleton dir defaults to ~/.claudevm/skeleton/
                                 (silently skipped if absent)
  claudevm claude <name>          Attach to (or start) Claude Code tmux session
  claudevm ssh <name> [ssh-opts] [-- cmd [args...]]
                                 Interactive shell, or run a remote command.
                                 Flags starting with '-' go to SSH; first non-flag
                                 arg (or anything after --) is the remote command.
                                   claudevm ssh myvm -A          # forward SSH agent
                                   claudevm ssh myvm -- ls -la   # run remote command
                                   claudevm ssh myvm -A -- foo   # both
  claudevm root <name>            Interactive shell as root
  claudevm suspend <name>         Stop the VM (preserves disk)
  claudevm resume <name>          Start a suspended VM
  claudevm destroy <name>         Permanently delete VM and all data
  claudevm list                   List all VMs
  claudevm status [name]          Show VM status
  claudevm ip <name>              Show VM networking info
  claudevm ssh-config <name>      Print SSH config block for ~/.ssh/config
  claudevm push <name>              Sync current dir to VM at same path relative to HOME
                                     (e.g. ~/work/proj -> VM:~/work/proj)
  claudevm push <name> <local-path> [<remote-path>]
                                   Copy file/dir from host to VM (default: ~/work/<basename>)
                                   Quote remote paths with ~ to prevent local expansion:
                                     claudevm push myvm file.txt '~/.config/file.txt'
  claudevm pull <name>              Sync current dir from VM at same path relative to HOME
                                     (e.g. VM:~/work/proj -> ~/work/proj)
  claudevm pull <name> <remote-path> [<local-path>]
                                   Copy file/dir from VM to host (default: current dir)
                                   Quote remote paths with ~:
                                     claudevm pull myvm '~/work/output.txt'
  claudevm creds <name>            Re-sync Claude Code credentials from Mac Keychain
  claudevm forward <name> <port> [host-port]
                                   Ad-hoc port forward from host to VM

Notes:
  - Claude Code runs in bypassPermissions mode (set via settings.json defaultMode).
  - The tmux session is named 'claude'. Detach with Ctrl-q d; reattach with
    'claudevm claude <name>'.
  - Services running on common ports (3000, 4000, 5000, 8000, 8080, 8888,
    9000) are automatically forwarded to localhost on the Mac.
  - Skeleton: ~/.claudevm/skeleton/ (dotfiles/dirs copied into VM home on create)
  - VM template (cpus/memory/disk/ports) is embedded in this script
EOF
}

CMD="${1:-}"
shift || true

case "$CMD" in
    create)       cmd_create "$@" ;;
    creds)        cmd_creds "$@" ;;
    claude)       cmd_claude "$@" ;;
    ssh|connect)  cmd_ssh "$@" ;;
    root)         cmd_root "$@" ;;
    suspend)      cmd_suspend "$@" ;;
    resume)       cmd_resume "$@" ;;
    destroy)      cmd_destroy "$@" ;;
    list)         cmd_list ;;
    status)       cmd_status "$@" ;;
    ip)           cmd_ip "$@" ;;
    ssh-config)   cmd_ssh_config "$@" ;;
    push)         cmd_push "$@" ;;
    pull)         cmd_pull "$@" ;;
    forward)      cmd_port_forward "$@" ;;
    help|--help|-h) usage ;;
    "")           usage ;;
    *)            die "Unknown command: $CMD. Run 'claudevm help' for usage." ;;
esac
